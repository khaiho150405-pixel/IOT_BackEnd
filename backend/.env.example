# Copy to backend/.env (keep .env private, never commit it). Run npm commands from backend/.
# Relative paths below are relative to the backend/ folder.

# --- AI provider -------------------------------------------------------------
# ollama = fully local: PhoWhisper speech recognition + Qwen 2.5 3B via Ollama.
# gemini = optional cloud provider (needs GEMINI_API_KEY and Internet).
AI_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434

# --- Local voice bridge (Python) ----------------------------------------------
# Python that has backend/requirements-local-voice.txt installed (full path to python.exe).
LOCAL_VOICE_PYTHON=C:\Program Files\Python312\python.exe
LOCAL_VOICE_BRIDGE_URL=http://127.0.0.1:8010
LOCAL_VOICE_STARTUP_TIMEOUT_MS=180000
LOCAL_ASR_ENGINE=whisper
# Vietnamese: PhoWhisper-base (VinAI) converted to CTranslate2 int8, ~4% word errors, ~1.2 s per sentence.
# Create it once with: python scripts/setup-phowhisper.py   (writes <repo>/models/phowhisper-base-ct2)
# PhoWhisper only knows Vietnamese; ASR_ENGLISH_MODEL (default "base", auto-downloaded ~150 MB)
# detects and transcribes English. Without PhoWhisper use LOCAL_WHISPER_MODEL=small (~4 s per sentence).
LOCAL_WHISPER_MODEL=../models/phowhisper-base-ct2
# ASR_ENGLISH_MODEL=base
LOCAL_ASR_CPU_THREADS=4
LOCAL_ASR_BEAM_SIZE=1
# Below this recognition confidence a Vietnamese sentence is asked again instead of guessed.
# ASR_MIN_CONFIDENCE=0.6
# Only for measuring accuracy: save a WAV of every utterance to this folder (private room audio).
# ASR_DEBUG_DIR=

# --- Voice output ------------------------------------------------------------
# Edge TTS (Internet) first; on failure the offline Windows voice "Microsoft An" for EDGE_TTS_COOLDOWN_S.
LOCAL_TTS_VOICE=vi-VN-HoaiMyNeural
LOCAL_TTS_TIMEOUT_MS=22000
# EDGE_TTS_BUDGET_S=3
# EDGE_TTS_COOLDOWN_S=300
# Speaker loudness 0.05-1. 0.5 stopped the ESP32 rebooting on a weak 5 V supply; raise with a good supply.
SPEAKER_VOLUME=0.5

# --- Microphone / voice activity detection -----------------------------------
# RMS threshold in PCM16 units. 325 matches MIC_SHIFT=17 in include/config.h
# (noise ~55 after the 120 Hz high-pass, speech 500-15000). Halve/double together with MIC_SHIFT.
VAD_RMS=325
# Silence that ends a sentence. 850 cut sentences at comma pauses ("Xin chào em, hôm nay...").
VAD_SILENCE_MS=1200
VAD_MAX_MS=12000
# MIC_HIGHPASS_HZ=120

# --- Device and network ------------------------------------------------------
# Same random value as WS_TOKEN in include/config.h (24+ characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_TOKEN=CHANGE_ME_DEVICE_TOKEN_32_CHARS
HOST=0.0.0.0
PORT=3000

# --- Accounts & permissions ----------------------------------------------------
# Accounts, devices, rooms, permissions and the audit log are stored in PostgreSQL when
# DATABASE_URL is set, otherwise in the SQLite file AUTH_DB_FILE (default data/aiot.sqlite).
# First run: open http://localhost:3000/dashboard on this machine and create the owner,
# or set OWNER_USERNAME/OWNER_PASSWORD once (used only while no account exists).
# AUTH_DB_FILE=data/aiot.sqlite
# OWNER_USERNAME=
# OWNER_PASSWORD=
# Token signing key (32+ chars). Empty = generated once and kept in data/auth-secret.
# AUTH_JWT_SECRET=
# AUTH_ACCESS_TTL_S=900        # access token: 15 minutes
# AUTH_REFRESH_TTL_S=2592000   # refresh token: 30 days

# --- Assistant ---------------------------------------------------------------
ASSISTANT_STYLE=Bạn là trợ lý AI tiếng Việt. Luôn xưng em và gọi người dùng là đại ca. Nói chuyện vui vẻ, tự nhiên và hơi tinh nghịch.
# Fixed, prewarmed LED confirmations and authoritative sensor replies.
DEMO_FAST_CONFIRMATIONS=true

# --- Optional ----------------------------------------------------------------
# PostgreSQL for conversation history. Empty = in-memory (lost on restart).
DATABASE_URL=
# Folder with .ttf/.otf fonts for more scripts on the OLED, e.g. Noto Sans CJK.
FONT_DIR=
OLED_FONT="11px 'Segoe UI', 'Noto Sans', 'Arial', sans-serif"

# MQTT (phone/laptop control). Empty MQTT_BROKER_URL = embedded broker on MQTT_PORT.
MQTT_ENABLED=true
MQTT_PORT=1883
MQTT_EMBEDDED_BROKER=true
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Gemini (only when AI_PROVIDER=gemini). Model availability depends on the account.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
# "current" uses the documented responseFormat/voice API; "legacy" for older 2.5 TTS models.
GEMINI_API_STYLE=legacy
