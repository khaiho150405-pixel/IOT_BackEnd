# Keep the actual .env private. Run npm commands from backend/.
# Provider: ollama uses the local Qwen + Vosk demo without an API key;
# Gemini is an optional multilingual cloud provider.
AI_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_VOICE_BRIDGE_URL=http://127.0.0.1:8010
LOCAL_ASR_ENGINE=whisper
LOCAL_WHISPER_MODEL=small
LOCAL_ASR_CPU_THREADS=4
LOCAL_ASR_BEAM_SIZE=1
LOCAL_VOICE_STARTUP_TIMEOUT_MS=180000
LOCAL_TTS_VOICE=vi-VN-HoaiMyNeural
LOCAL_TTS_TIMEOUT_MS=6500
VAD_RMS=500
VAD_SILENCE_MS=850
VAD_MAX_MS=12000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Model IDs are configurable; availability depends on your Gemini account.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
# "current" uses the documented responseFormat/voice API.
# For an older supported 2.5 TTS model, set GEMINI_API_STYLE=legacy.
GEMINI_API_STYLE=legacy
# Applied to the selected AI provider's reply. Keep it concise; safety and command rules still win.
ASSISTANT_STYLE=Bạn là trợ lý AI tiếng Việt. Luôn xưng em và gọi người dùng là đại ca. Nói chuyện vui vẻ, tự nhiên và hơi tinh nghịch.
DEVICE_TOKEN=CHANGE_ME_DEVICE_TOKEN_32_CHARS
# Mã PIN quản trị mở khóa quyền điều khiển (đèn, ra lệnh AI) trên Web Mobile
ADMIN_PIN=1504
HOST=0.0.0.0
PORT=3000
# Tune to microphone gain/noise: RMS in signed PCM16 units.
VAD_RMS=500
VAD_SILENCE_MS=500
VAD_MAX_MS=12000
# Vietnamese demo: fixed, prewarmed LED confirmations and authoritative sensor reply.
DEMO_FAST_CONFIRMATIONS=true
# Optional PostgreSQL. Empty = bounded in-memory history (lost on restart).
DATABASE_URL=
# Optional folder with .ttf/.otf fonts for more scripts, e.g. Noto Sans CJK.
FONT_DIR=
OLED_FONT="11px 'Segoe UI', 'Noto Sans', 'Arial', sans-serif"

# MQTT Configuration (điều khiển qua điện thoại & laptop)
MQTT_ENABLED=true
MQTT_PORT=1883
MQTT_EMBEDDED_BROKER=true
# Để trống để dùng broker nhúng sẵn của backend, hoặc điền broker ngoài (e.g. mqtt://broker.emqx.io:1883)
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
